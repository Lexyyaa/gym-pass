# @expect $.errorCode == "MEMBERSHIP_NOT_FOUND"
POST {{host}}/api/memberships/999999/pauses
Content-Type: application/json
X-Branch-Id: 1

{ "startDate": "2026-09-20", "days": 1 }

### [TC-4-03] 누적 일수 상한 초과 (횟수제 42일 < 43일) → 409, 종료일 불변
# @expect 409
# @expect $.errorCode == "PAUSE_DAYS_LIMIT_EXCEEDED"
# @db SELECT COUNT(*) FROM membership_pause WHERE membership_id = 2 => 0
# @db SELECT end_date FROM membership WHERE id = 2 => 2027-03-01
POST {{host}}/api/memberships/2/pauses
Content-Type: application/json
X-Branch-Id: 1

{ "startDate": "2026-10-01", "days": 43 }

### [TC-4-04-준비1] 회원권 1에 두 번째 정지 (1일)
# @expect 200
# @expect $.membershipEndDate == "2027-09-09"
POST {{host}}/api/memberships/1/pauses
Content-Type: application/json
X-Branch-Id: 1

{ "startDate": "2026-10-01", "days": 1 }

### [TC-4-04-준비2] 회원권 1에 세 번째 정지 (1일)
# @expect 200
# @expect $.membershipEndDate == "2027-09-10"
POST {{host}}/api/memberships/1/pauses
Content-Type: application/json
X-Branch-Id: 1

{ "startDate": "2026-10-05", "days": 1 }

### [TC-4-04] 네 번째 정지 → 409, 정지 3건 유지
# @expect 409
# @expect $.errorCode == "PAUSE_COUNT_LIMIT_EXCEEDED"
# @db SELECT COUNT(*) FROM membership_pause WHERE membership_id = 1 => 3
# @db SELECT end_date FROM membership WHERE id = 1 => 2027-09-10
POST {{host}}/api/memberships/1/pauses
Content-Type: application/json
X-Branch-Id: 1

{ "startDate": "2026-10-10", "days": 1 }

### [TC-4-13] 시작 전 조기 해제 → 사용 0일, 종료일 원복
# @uses futurePauseId = [TC-4-04-준비1].$.pauseId
# @expect 200
# @expect $.usedDays == 0
# @expect $.membershipEndDate == "2027-09-09"
# @db SELECT released_date FROM membership_pause WHERE id = {{futurePauseId}} => 2026-09-17
# @db SELECT COUNT(*) FROM membership_history WHERE membership_id = 1 AND event_type = 'RESUMED' => 1
POST {{host}}/api/memberships/1/pauses/{{futurePauseId}}/release
X-Branch-Id: 1

### [TC-4-13-횟수] 시작 전 해제한 정지는 횟수에서 빠져 네 번째 등록이 허용된다
# @expect 200
# @expect $.membershipEndDate == "2027-09-10"
# @db SELECT COUNT(*) FROM membership_pause WHERE membership_id = 1 => 4
POST {{host}}/api/memberships/1/pauses
Content-Type: application/json
X-Branch-Id: 1

{ "startDate": "2026-10-20", "days": 1 }

### [TC-4-06-준비] 회원권 2 오늘 시작 정지 3일 → 즉시 PAUSED
# @expect 200
# @expect $.startDate == "2026-09-17"
# @expect $.endDate == "2026-09-19"
# @expect $.membershipEndDate == "2027-03-04"
